# Copy to .env and set a private Grafana password before starting Compose.
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-local-password

# Python reads these from the shell. Compose does not export them to the shell.
SOC_KAFKA_BOOTSTRAP=127.0.0.1:9092
SOC_KAFKA_TOPIC=security-events
SOC_KAFKA_GROUP_ID=soc-detection-engine
SOC_KAFKA_OFFSET_RESET=latest
SOC_DETECTION_OUTPUT=telemetry/detection_alerts.jsonl
SOC_FORWARDED_ALERTS_DB=telemetry/forwarded_alerts.sqlite3
# Set only when following a specific telemetry JSONL file.
FALCO_EVENTS_FILE=

ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_EVENTS_INDEX=security-events
ELASTICSEARCH_ALERTS_INDEX=security-alerts
# For an authenticated endpoint, fill either the pair or the API key.
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# Set privately, only when sending alerts to your own n8n workflow.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT=5
