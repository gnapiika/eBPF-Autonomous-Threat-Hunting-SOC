#!/usr/bin/env python3
"""Write one harmless synthetic Falco-shaped JSON event to the configured JSONL file."""
import json
import os
from datetime import datetime, timezone
from pathlib import Path

path = Path(os.getenv("FALCO_EVENTS_FILE", "/tmp/falco-events.json"))
path.parent.mkdir(parents=True, exist_ok=True)
sample = {
    "time": datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
    "rule": "Synthetic Lab Process Event",
    "priority": "Notice",
    "output": "Synthetic test event only; no real process was executed",
    "output_fields": {
        "proc.name": "synthetic-lab-process",
        "proc.pid": 424242,
        "proc.pname": "synthetic-parent",
        "proc.cmdline": "synthetic --demo",
        "user.name": "lab-user",
        "evt.type": "execve"
    }
}
with path.open("a", encoding="utf-8") as f:
    f.write(json.dumps(sample) + "\n")
print(f"Wrote a synthetic test event to {path}")